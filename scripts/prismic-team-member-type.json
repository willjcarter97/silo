{
  "id": "team_member",
  "label": "Team Member",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL Slug",
          "placeholder": "e.g. ruby-turbett"
        }
      },
      "name": {
        "type": "Text",
        "config": {
          "label": "Full Name",
          "placeholder": "e.g. Ruby Turbett"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Job Title",
          "placeholder": "e.g. Founder"
        }
      },
      "description": {
        "type": "Text",
        "config": {
          "label": "Bio Description",
          "placeholder": "Short bio about the team member (2-3 sentences)"
        }
      },
      "photo": {
        "type": "Image",
        "config": {
          "label": "Photo",
          "constraint": {
            "width": 800,
            "height": 800
          },
          "thumbnails": []
        }
      },
      "display_order": {
        "type": "Number",
        "config": {
          "label": "Display Order",
          "placeholder": "Lower numbers appear first (e.g. 1, 2, 3)"
        }
      },
      "is_active": {
        "type": "Boolean",
        "config": {
          "label": "Active",
          "placeholder_false": "Hidden",
          "placeholder_true": "Visible",
          "default_value": true
        }
      }
    }
  }
}


