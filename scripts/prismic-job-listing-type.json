{
  "id": "job_listing",
  "label": "Job Listing",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "URL Slug",
          "placeholder": "e.g. smoothie-smash-ugc"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Job/Brand Title",
          "placeholder": "e.g. Smoothie Smash"
        }
      },
      "category": {
        "type": "Text",
        "config": {
          "label": "Category",
          "placeholder": "e.g. Food & Drink, Energy, B2B"
        }
      },
      "card_image": {
        "type": "Image",
        "config": {
          "label": "Card Image",
          "constraint": {
            "width": 800,
            "height": 520
          },
          "thumbnails": []
        }
      },
      "publish_date": {
        "type": "Date",
        "config": {
          "label": "Publish Date",
          "placeholder": "When this job was posted"
        }
      },
      "is_active": {
        "type": "Boolean",
        "config": {
          "label": "Active",
          "placeholder_false": "Hidden",
          "placeholder_true": "Visible",
          "default_value": true
        }
      }
    },
    "Detail Page": {
      "primary_image": {
        "type": "Image",
        "config": {
          "label": "Primary Image (Hero)",
          "constraint": {
            "width": 1200,
            "height": 800
          },
          "thumbnails": []
        }
      },
      "secondary_image": {
        "type": "Image",
        "config": {
          "label": "Secondary Image",
          "constraint": {
            "width": 1200,
            "height": 720
          },
          "thumbnails": []
        }
      },
      "client_description": {
        "type": "StructuredText",
        "config": {
          "label": "Client Description",
          "placeholder": "Describe the client/brand and what they do...",
          "multi": "paragraph",
          "allowTargetBlank": true
        }
      }
    },
    "Contact": {
      "contact_name": {
        "type": "Text",
        "config": {
          "label": "Contact Name",
          "placeholder": "e.g. Ruby Turbett"
        }
      },
      "contact_title": {
        "type": "Text",
        "config": {
          "label": "Contact Title",
          "placeholder": "e.g. Position, Silo"
        }
      },
      "contact_email": {
        "type": "Text",
        "config": {
          "label": "Contact Email",
          "placeholder": "e.g. rt@thesilocreative.com"
        }
      },
      "contact_avatar": {
        "type": "Image",
        "config": {
          "label": "Contact Avatar",
          "constraint": {
            "width": 200,
            "height": 200
          },
          "thumbnails": []
        }
      }
    },
    "Requirements": {
      "looking_for": {
        "type": "Group",
        "config": {
          "label": "They're Looking For",
          "fields": {
            "requirement": {
              "type": "Text",
              "config": {
                "label": "Requirement",
                "placeholder": "e.g. Short-form video showing product use"
              }
            }
          }
        }
      },
      "not_looking_for": {
        "type": "Group",
        "config": {
          "label": "They're NOT Looking For",
          "fields": {
            "requirement": {
              "type": "Text",
              "config": {
                "label": "Requirement",
                "placeholder": "e.g. Overly polished ad-style content"
              }
            }
          }
        }
      }
    }
  }
}

